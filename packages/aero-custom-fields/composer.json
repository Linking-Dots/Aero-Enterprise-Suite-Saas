{
    "name": "aero/custom-fields",
    "description": "Custom Fields System for aeos365 - cross-module custom field definitions, field types, and validation rules",
    "type": "library",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "Aero\\CustomFields\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Aero\\CustomFields\\Providers\\CustomFieldsServiceProvider"
            ]
        },
        "aero": {
            "tier": "product"
        }
    },
    "require": {
        "php": "^8.2",
        "aero/core": "^1.0",
        "aero/contracts": "^1.0"
    }
}
